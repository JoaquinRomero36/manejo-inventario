@* Controles de paginación del banner de alertas (pantalla táctil, sin scroll). *@
<div class="alerta-stock-paginacion">
    <button type="button" class="btn btn-default alerta-stock-prev" aria-label="Ver alertas anteriores">
        <i class="fa fa-chevron-left" aria-hidden="true"></i> Atrás
    </button>
    <span class="alerta-stock-contador" aria-live="polite"></span>
    <button type="button" class="btn btn-default alerta-stock-next" aria-label="Ver más alertas">
        Adelante <i class="fa fa-chevron-right" aria-hidden="true"></i>
    </button>
</div>
