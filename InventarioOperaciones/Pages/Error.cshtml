@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger">
    <h1><i class="fa fa-times-circle" aria-hidden="true"></i> Ocurrió un error</h1>
    <p>No se pudo procesar la solicitud. Intente nuevamente o contacte al administrador.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted"><small>Referencia: <code>@Model.RequestId</code></small></p>
    }
    <a asp-page="/Productos" class="btn btn-primary">Volver</a>
</div>