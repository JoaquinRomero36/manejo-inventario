@model List<ProductoAdminFila>
@*
    Parcial de la tabla de productos (App Admin). Se refresca por AJAX tras crear, habilitar o deshabilitar.
*@

<table id="tablaProductos" class="table table-striped table-bordered table-condensed" style="width:100%">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Categoría</th>
            <th class="text-right">Disponible</th>
            <th class="text-right">Mínimo</th>
            <th class="text-center">Estado</th>
            <th class="text-center">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fila in Model)
        {
            <tr>
                <td>@fila.Nombre</td>
                <td>@fila.Categoria</td>
                <td class="text-right">@fila.CantidadDisponible</td>
                <td class="text-right">@fila.CantidadMinima</td>
                <td class="text-center">
                    @if (!fila.Activo)
                    {
                        <span class="label label-default">Inactivo</span>
                    }
                    else if (fila.AlertaActiva)
                    {
                        <span class="label label-danger">
                            <i class="fa fa-exclamation-triangle" aria-hidden="true"></i> Alerta
                        </span>
                    }
                    else
                    {
                        <span class="label label-success">Activo</span>
                    }
                </td>
                <td class="text-center">
                    @if (fila.Activo)
                    {
                        <button type="button" class="btn btn-danger btn-xs btn-deshabilitar"
                                data-id="@fila.Id" data-nombre="@fila.Nombre">
                            <i class="fa fa-ban" aria-hidden="true"></i> Deshabilitar
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-success btn-xs btn-habilitar"
                                data-id="@fila.Id" data-nombre="@fila.Nombre">
                            <i class="fa fa-check" aria-hidden="true"></i> Habilitar
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>