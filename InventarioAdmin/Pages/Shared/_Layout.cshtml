@{
    // Sin login: no se muestra usuario ni botón de salida.
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/extensions/buttons/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-inverse navbar-static-top" role="navigation">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#menu-principal">
                    <span class="sr-only">Alternar navegación</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" asp-page="/Dashboard">
                    <i class="fa fa-dashboard" aria-hidden="true"></i> Inventario Admin
                </a>
            </div>
            <div class="collapse navbar-collapse" id="menu-principal">
                <ul class="nav navbar-nav">
                    <li><a asp-page="/Dashboard"><i class="fa fa-dashboard" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a asp-page="/Productos"><i class="fa fa-cubes" aria-hidden="true"></i> Productos</a></li>
                    <li><a asp-page="/Categorias"><i class="fa fa-tags" aria-hidden="true"></i> Categorías</a></li>
                    <li><a asp-page="/Usuarios"><i class="fa fa-users" aria-hidden="true"></i> Usuarios</a></li>
                    <li><a asp-page="/Proveedores"><i class="fa fa-truck" aria-hidden="true"></i> Proveedores</a></li>
                    <li><a asp-page="/Historial"><i class="fa fa-history" aria-hidden="true"></i> Historial</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @Html.AntiForgeryToken()

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.min.js"></script>
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/extensions/buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables/extensions/buttons/js/buttons.html5.min.js"></script>
    <script src="~/lib/datatables/extensions/buttons/js/buttons.print.min.js"></script>
    <script src="~/lib/jszip/jszip.min.js"></script>
    <script src="~/lib/pdfmake/pdfmake.min.js"></script>
    <script src="~/lib/pdfmake/vfs_fonts.js"></script>
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>