@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="alert alert-danger">
    <h1><i class="fa fa-times-circle" aria-hidden="true"></i> Ups, algo salió mal</h1>
    <p>Hubo un problema al procesar tu pedido. Volvé a intentarlo en unos segundos.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-muted"><small>Referencia: <code>@Model.RequestId</code></small></p>
    }
    <a asp-page="/Dashboard" class="btn btn-primary">Volver</a>
</div>