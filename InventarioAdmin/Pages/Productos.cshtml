@page
@model ProductosModel
@{
    ViewData["Title"] = "Productos";
}

<div class="page-header">
    <h2>
        <i class="fa fa-cubes" aria-hidden="true"></i> Productos
        <button type="button" class="btn btn-primary pull-right" id="btnNuevo">
            <i class="fa fa-plus" aria-hidden="true"></i> Nuevo producto
        </button>
    </h2>
</div>

<div class="alert alert-success hidden" id="alertaExito" role="alert"></div>

<div id="contenedorTabla">
    <partial name="_ProductosTable" model="Model.Filas" />
</div>

<!-- Modal alta de producto -->
<div class="modal fade" id="modalProducto" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title">Nuevo producto</h4>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger hidden" id="errorModal" role="alert"></div>

                <div class="form-group">
                    <label for="nombre">Nombre <span class="text-danger">*</span></label>
                    <input type="text" id="nombre" class="form-control" maxlength="200" />
                </div>

                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <input type="text" id="descripcion" class="form-control" maxlength="1000" />
                </div>

                <div class="form-group">
                    <label for="idCategoria">Categoría <span class="text-danger">*</span></label>
                    <select id="idCategoria" class="form-control"></select>
                </div>

                <div class="form-group">
                    <label for="cantidadMinima">Cantidad mínima <span class="text-danger">*</span></label>
                    <input type="number" id="cantidadMinima" class="form-control" min="0" step="1" value="0" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/productos.js"></script>
}