@page
@model ProveedoresModel
@{
    ViewData["Title"] = "Proveedores";
}

<div class="page-header">
    <h2>
        <i class="fa fa-truck" aria-hidden="true"></i> Proveedores
        <button type="button" class="btn btn-primary pull-right" id="btnNuevo">
            <i class="fa fa-plus" aria-hidden="true"></i> Nuevo proveedor
        </button>
    </h2>
</div>

<div class="alert alert-success hidden" id="alertaExito" role="alert"></div>

<div id="contenedorTabla">
    <partial name="_ProveedoresTable" model="Model.Filas" />
</div>

<!-- Modal alta/edición de proveedor -->
<div class="modal fade" id="modalProveedor" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="tituloProveedor">Nuevo proveedor</h4>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger hidden" id="errorModal" role="alert"></div>
                <input type="hidden" id="idProveedor" value="0" />

                <div class="form-group">
                    <label for="numero">Número <span class="text-danger">*</span></label>
                    <input type="text" id="numero" class="form-control" maxlength="100" />
                </div>

                <div class="form-group">
                    <label for="gmail">Gmail</label>
                    <input type="text" id="gmail" class="form-control" maxlength="200" />
                </div>

                <div class="form-group">
                    <label for="descripcion">Descripción</label>
                    <input type="text" id="descripcion" class="form-control" maxlength="500" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnGuardar">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/proveedores.js"></script>
}